# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets: never commit these ---
.env
.env.*
secrets.json
*.key
*.pem
credentials.json
.netrc

# --- Nova runtime data (lives in %LOCALAPPDATA%\Nova, but ignore local copies) ---
nova_data/
*.db
*.db-shm
*.db-wal
*.log
logs/
screenshots/
voice/profile.json

# --- Editors / OS ---
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
